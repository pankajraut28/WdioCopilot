{
  "name": "wdio-copilot",
  "version": "1.0.0",
  "description": "Production-ready WebdriverIO automation framework with Cucumber BDD and Page Object Model",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:headless": "HEADLESS=true wdio run wdio.conf.js",
    "test:chrome": "BROWSER=chrome wdio run wdio.conf.js",
    "test:firefox": "BROWSER=firefox wdio run wdio.conf.js",
    "test:single": "wdio run wdio.conf.js --grep",
    "test:tag": "wdio run wdio.conf.js --require-module @babel/register --tags",
    "test:parallel": "wdio run wdio.conf.js --maxInstances=4",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "clean": "rm -rf allure-results allure-report screenshots logs"
  },
  "keywords": [
    "webdriverio",
    "cucumber",
    "bdd",
    "automation",
    "e2e-testing",
    "page-object-model"
  ],
  "author": "Pankaj Raut",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/register": "^7.24.0",
    "@wdio/allure-reporter": "^8.28.0",
    "@wdio/cli": "^8.28.0",
    "@wdio/cucumber-framework": "^8.28.0",
    "@wdio/local-runner": "^8.28.0",
    "@wdio/spec-reporter": "^8.28.0",
    "dotenv": "^16.3.1",
    "expect-webdriverio": "^4.8.0",
    "webdriverio": "^8.28.0"
  },
  "dependencies": {
    "winston": "^3.11.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
