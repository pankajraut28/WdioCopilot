{
  "name": "wdio-copilot",
  "version": "1.0.0",
  "description": "WebdriverIO Automation Framework with Cucumber BDD",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:chrome": "BROWSER=chrome wdio run wdio.conf.js",
    "test:firefox": "BROWSER=firefox wdio run wdio.conf.js",
    "test:headless": "HEADLESS=true wdio run wdio.conf.js",
    "test:smoke": "wdio run wdio.conf.js --tags @smoke",
    "test:regression": "wdio run wdio.conf.js --tags @regression",
    "test:login": "wdio run wdio.conf.js --spec features/login.feature",
    "report": "allure serve ./allure-results",
    "report:generate": "allure generate ./allure-results -o ./allure-report --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf ./allure-results ./allure-report ./screenshots ./logs",
    "pretest": "npm run clean"
  },
  "keywords": [
    "webdriverio",
    "cucumber",
    "bdd",
    "automation",
    "testing"
  ],
  "author": "Pankaj Raut",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/register": "^7.22.0",
    "@wdio/cli": "^8.13.0",
    "@wdio/cucumber-framework": "^8.13.0",
    "@wdio/local-runner": "^8.13.0",
    "@wdio/spec-reporter": "^8.13.0",
    "@wdio/allure-reporter": "^8.13.0",
    "@wdio/chromedriver-service": "^8.13.0",
    "chromedriver": "^115.0.0",
    "expect-webdriverio": "^4.6.0",
    "eslint": "^8.44.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "allure-commandline": "^2.25.0",
    "dotenv": "^16.3.1",
    "winston": "^3.9.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}